# Secrets
.env
.env.bak*
.mcp.json
claudebot.env
personalinfo.md
*.credentials.json
tasks/
# Local working notes on a live install — never existed upstream, but a machine
# that still has one should not surface it to `git add .`.
install/openissues.md

# Claude credentials
.claude/.credentials.json
.claude/.credentials.json.backup

# Claude Code settings — never commit. In container mode ~/.claude is symlinked
# to $CLAUDE_HOME/.claude (see Containerfile), so this IS the live runtime
# settings file: the installer rewrites it on every run with machine-specific
# absolute hook paths. Tracking it left the working tree permanently dirty and
# made `git pull` conflict. The shipped template is
# config/claude-settings.json.example, which install/config.sh merges in.
.claude/settings.json
.claude/settings.local.json

# Node
node_modules/
bun.lock
package-lock.json

# Runtime-installed Claude Code CLI (container mode) — pulled into the bind mount
# at first run because CC is not redistributable and is never baked into the image
/.npm-global/

# Chrome profile (cookies, sessions, saved passwords — written by start-browser.sh)
.chrome-profile/

# Package caches (uv/npm) — moved off the 512MB /tmp tmpfs onto the persistent
# bind mount under $CLAUDE_HOME/.cache to stop /tmp exhaustion crashing Chrome (#305)
/.cache/

# Scheduler state — contains verbatim user task prompts
.crontab

# Task artifacts
*.png
*.jpg
screenshots/
skills-lock.json

# Personal project files. EVERYTHING under projects/ is ignored, including the
# index — projects/README.md is a live working file that accumulates real client
# names, deal context and personal detail, so it must never be tracked. No
# template is shipped either: Claude creates the index on first use and rebuilds
# it from projects/*/CLAUDE.md if it goes missing (see CLAUDE.md "Project
# Structure").
#
# This is layer 1 of three. Layer 2 is the pre-commit hook in core/git-hooks/,
# layer 3 is the "Guard tracked paths" CI workflow, which is the one that
# actually holds when the other two are bypassed. See docs/project-structure.md.
projects/*
!projects/.gitkeep

# Logs
*.log
logs/

# Generated files
config/systemd/generated/

# Catch-all: task scripts/data left in root by mistake
# (all task work should go in projects/*/)
/*.js
/*.py
/*.json
!package.json
/*.txt
!THIRD_PARTY_NOTICES.txt
/*.sh
!/install.sh
!/entrypoint.sh
!/build-image.sh

# Install / runtime state sentinels
.install-complete
.gitconfig
.welcome-sent
.welcome-armed
.auth-complete
.force-install-done

# Temp
/tmp/

# Python bytecode
__pycache__/
*.pyc

# Claude Code skill discovery — generated by core/link-skills.sh at install/boot
# from .agents/skills/. Not committed: a git symlink checks out as a plain text
# file wherever core.symlinks is false (Windows without Developer Mode), which
# silently breaks skill loading.
/.claude/skills/
