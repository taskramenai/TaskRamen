# -- Paths --
CLAUDE_HOME=/home/YOUR_USERNAME/taskramen
USER_HOME=/home/YOUR_USERNAME

# -- Telegram --
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# -- Claude Code authentication --
# Set by install/claude-auth.sh. Two mutually exclusive modes:
#   setup-token flow  -> this key holds the OAuth token (uncommented)
#   interactive login -> this key stays COMMENTED OUT and the credential lives in
#                        ~/.claude/.credentials.json instead
# entrypoint.sh treats an uncommented value here as proof that auth completed,
# so do not uncomment it with an empty/placeholder value.
#CLAUDE_CODE_OAUTH_TOKEN=

# -- Google Workspace (no MCP; direct REST via claudeconnectorskillheadless) --
# Populated by the connector OAuth flow — see CLAUDE.md "Connecting Services".
SERVICE_GOOGLE_WORKSPACE_RW_ACCESS_TOKEN=
SERVICE_GOOGLE_WORKSPACE_RW_REFRESH_TOKEN=
SERVICE_GOOGLE_WORKSPACE_RW_CLIENT_ID=
SERVICE_GOOGLE_WORKSPACE_RW_CLIENT_SECRET=
SERVICE_GOOGLE_WORKSPACE_RW_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
SERVICE_GOOGLE_WORKSPACE_RW_SCOPES=
SERVICE_GOOGLE_WORKSPACE_RW_EMAIL=your-assistant@gmail.com

# -- SerpAPI (Google Search/Flights/Maps) — populated by the connector flow --
# See CLAUDE.md "Connecting SerpAPI" / claudeconnectorskillheadless/serpapiconnect.md
SERPAPI_KEY=

# -- OpenRouter (fallback LLM when Claude quota exhausted) --
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# -- Webhook Channel (auto-generated, used by inject.sh and webhook server) --
WEBHOOK_CHANNEL_SECRET=YOUR_WEBHOOK_CHANNEL_SECRET

# -- Timezones (auto-detected at install by deps.sh; see CLAUDE.md "Scheduling") --
# USER_TIMEZONE   = user's wall-clock zone (geolocated via ipinfo.io)
# SYSTEM_TIMEZONE = scheduler frame (container: UTC; VM: host clock)
USER_TIMEZONE=
SYSTEM_TIMEZONE=

# -- Location (auto-detected at install by deps.sh; changed via the
#    update-location skill). Used for locale-aware defaults such as currency.
# VM_COUNTRY = ISO 3166-1 alpha-2, uppercase (e.g. US)
# VM_CITY    = city name (e.g. Boston)
VM_COUNTRY=
VM_CITY=

# -- Browser viewer --
# Absolute path to the cloudflared binary, if it is not on PATH. Used by
# browser-viewer/start-tunnel.sh to expose the viewer for user intervention.
CLOUDFLARED_BIN=

# -- Personal info (name, phone, passport, addresses, partner, etc.) lives in
#    personalinfo.md, NOT here. It is gitignored + chmod 600.
#    See personalinfo.md.example for the schema. The service-account email is
#    SERVICE_GOOGLE_WORKSPACE_RW_EMAIL above (== <SERVICE_EMAIL>).
